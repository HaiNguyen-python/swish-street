{
  "name": "swish-street",
  "version": "0.5.0",
  "private": true,
  "description": "Swish Street: a street-basketball journey for kids aged 9-12.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "ios:add": "npx cap add ios && sh scripts/configure-ios.sh",
    "ios:assets": "npx capacitor-assets generate --ios --assetPath resources",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/assets": "^3.0.5"
  }
}
